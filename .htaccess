<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>


SetEnvIf Request_URI "(admin-login|index)\.php$" allow_file
<FilesMatch "\.(php|blade\.php)$">
    Order Deny,Allow
    Deny from all
    Allow from env=allow_file
</FilesMatch>
