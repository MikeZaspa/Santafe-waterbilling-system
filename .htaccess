<IfModule mod_rewrite.c>
    RewriteEngine On

    # -----------------------------------------------------
    # BLOCK DIRECT ACCESS TO /public/index.php
    # -----------------------------------------------------
    RewriteCond %{THE_REQUEST} "\s/public/index\.php"
    RewriteRule ^ - [F]

    # Block ALL PHP files inside /public
    RewriteRule ^public/.*\.php$ - [F]

    # -----------------------------------------------------
    # ✅ BLOCK /images/* → 403
    # -----------------------------------------------------
    RewriteCond %{REQUEST_URI} ^/images/ [NC]
    RewriteRule ^ - [F,L]

    # -----------------------------------------------------
    # ✅ BLOCK /public/images/* → 403
    # -----------------------------------------------------
    RewriteCond %{REQUEST_URI} ^/public/images/ [NC]
    RewriteRule ^ - [F,L]

    # -----------------------------------------------------
    # Route All Requests to /public Folder
    # -----------------------------------------------------
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>
