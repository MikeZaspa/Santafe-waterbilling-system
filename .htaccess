<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Redirect /admin-consumer to /admin-login
RewriteRule ^admin-consumer/?$ admin-login [L,R=301]
</IfModule>

