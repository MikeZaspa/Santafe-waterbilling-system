<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Allow exceptions (admin-login and admin-dashboard)
SetEnvIf Request_URI "^/admin-login(\.php|\.blade\.php)?$" allow_file
SetEnvIf Request_URI "^/admin-dashboard(\.php|\.blade\.php)?$" allow_file

# Block all other PHP or Blade files
<FilesMatch "\.(blade\.php|php)$">
    Order Deny,Allow
    Deny from all
    Allow from env=allow_file
</FilesMatch>

# Block direct access to sensitive files (.env, composer, artisan)
<FilesMatch "^(\.env|composer\.(json|lock)|artisan)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Block sensitive Laravel directories
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor)/ - [F,L,NC]
</IfModule>
