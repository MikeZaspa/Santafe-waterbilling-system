<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Allow index.php and admin-login via env flag
SetEnvIf Request_URI "^/(index|admin-login)(\.php|\.blade\.php)?$" allow_file

<FilesMatch "\.(blade\.php|php)$">
    Order Deny,Allow
    Deny from all
    Allow from env=allow_file
</FilesMatch>

# (Ibalik ang uban nga rules sa ubos)
# Block direct access to .env and composer files
<FilesMatch "^(\.env|composer\.(json|lock)|artisan)$">
    Order Deny,Allow
    Deny from all
</FilesMatch>

# Deny access to sensitive folders by URL
RewriteEngine On
RewriteRule ^(app|bootstrap|config|database|resources|storage|vendor)/ - [F,L,NC]