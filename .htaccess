<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct access to .blade.php files from anywhere
    RewriteCond %{REQUEST_URI} \.blade\.php$ [NC]
    RewriteRule .* - [R=302,L]

    # Redirect all requests to public folder
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Additional security - block direct blade file access
<Files "*.blade.php">
    Deny from all
</Files>

