Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Skip rewrite if the request is for public folder
    RewriteCond %{REQUEST_URI} ^/public [NC]
    RewriteRule ^ - [L]
    
    # Rewrite everything else to public folder
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>