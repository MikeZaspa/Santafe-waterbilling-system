<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Start the rewrite engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # --- SPECIFIC RULES GO HERE ---
    # Redirect a specific fake admin path to the real one
    # This rule MUST be placed before the general public folder rule.
    RewriteRule ^admin-consumer/?$ admin-login [L,R=301]

    # --- GENERAL RULES GO HERE ---
    # Redirect all requests that are not already for the /public folder
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L]

</IfModule>