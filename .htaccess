<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "\.php$">
    Order Deny,Allow
    Deny from all
    <Files "index.php">
        Order Allow,Deny
        Allow from all
    </Files>
    <Files "admin-login.php">
        Order Allow,Deny
        Allow from all
    </Files>
</FilesMatch>

