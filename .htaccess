<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Deny direct access to common Laravel folders if server is misconfigured
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|bootstrap|config|database|resources|storage|tests|vendor)/ - [F,L,NC]
    RewriteRule ^(\.env|composer\.(json|lock)|artisan)$ - [F,L,NC]
</IfModule>

# Block access to .env explicitly
<Files .env>
    Require all denied
</Files>

