<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header 
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Laravel Root .htaccess — Secure + Hostinger Compatible (Safe for Login)
# ===============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 🚫 Block direct /public access
  RewriteCond %{THE_REQUEST} "\s/public([/?#\s]|$)" [NC]
  RewriteRule ^ - [R=403,L]

  # 🚫 Block direct /index.php access
  RewriteCond %{THE_REQUEST} "^[A-Z]{3,}\s/+index\.php[?\s]" [NC]
  RewriteRule ^index\.php$ - [R=403,L]

  # ✅ Redirect everything else INTO /public (but not twice)
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [L]

  # 🧱 Strict block for sensitive images (Hostinger-safe)
  # Allows internal loading, blocks manual direct browser access
  RewriteCond %{THE_REQUEST} "GET\s+/+(logo\.png|header\.png|watermark\.png)[\s?]" [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?mccgradeinfo\.com [NC]
  RewriteRule ^(logo\.png|header\.png|watermark\.png)$ - [R=403,L]
</IfModule>

# ===============================================================
# 🔒 Security Hardening
# ===============================================================
RedirectMatch 404 /\.(env|git|ht|DS_Store)
RedirectMatch 404 /\.env\..*
RedirectMatch 404 ^/(storage|vendor|bootstrap|resources|config)/.*

Options -Indexes

# ===============================================================
# 🛡️ Security Headers
# ===============================================================
<IfModule mod_headers.c>
  Header always set X-XSS-Protection "1; mode=block"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), fullscreen=(self)"
</IfModule>
RewriteEngine On

RewriteEngine On

# Block direct access to /admin-dashboard
RewriteCond %{REQUEST_URI} ^/admin-dashboard/?$ [NC]
RewriteCond %{HTTP_REFERER} !^https://santafe-waterbilling\.com/admin-login [NC]
RewriteRule ^ - [R=404,L]


# =============================================
# BOOTSTRAP 3.3.7 VULNERABILITY FIXES
# =============================================

<IfModule mod_headers.c>
    # 1. CONTENT SECURITY POLICY - Blocks XSS in Bootstrap 3.3.7
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' https://maxcdn.bootstrapcdn.com https://ajax.googleapis.com; style-src 'self' 'unsafe-inline' https://maxcdn.bootstrapcdn.com; font-src 'self' https://maxcdn.bootstrapcdn.com; img-src 'self' data: https:; object-src 'none'; base-uri 'self'; form-action 'self'"
    
    # 2. STRICT XSS PROTECTION
    Header always set X-XSS-Protection "1; mode=block"
    
    # 3. PREVENT MIME SNIFFING
    Header always set X-Content-Type-Options "nosniff"
    
    # 4. CLICKJACKING PROTECTION
    Header always set X-Frame-Options "SAMEORIGIN"
    
    # 5. REFERRER POLICY
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 6. BLOCK BOOTSTRAP 3.3.7 DATA ATTRIBUTE EXPLOITS
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Block attempts to exploit Bootstrap data attributes
    RewriteCond %{QUERY_STRING} (data-toggle|data-target|data-content|data-html) [NC,OR]
    RewriteCond %{QUERY_STRING} (javascript:|alert\(|prompt\(|confirm\(|eval\() [NC,OR]
    RewriteCond %{QUERY_STRING} (<script|</script|onmouseover|onload|onerror) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# 7. SECURE COOKIE SETTINGS
<IfModule mod_headers.c>
    Header always edit Set-Cookie ^(.*)$ $1;HttpOnly;Secure;SameSite=Strict
</IfModule>

# 8. CACHE CONTROL FOR SECURITY
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Bootstrap files - long cache but secure
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # Dynamic content - no cache
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# 9. BLOCK SUSPICIOUS REQUESTS
<IfModule mod_rewrite.c>
    # Block common Bootstrap exploit patterns
    RewriteCond %{QUERY_STRING} (\.\./|\.\.\\|/\./|\\\.\) [NC,OR]
    RewriteCond %{QUERY_STRING} (boot\.ini|etc/passwd|self/environ) [NC,OR]
    RewriteCond %{QUERY_STRING} (union.*select|select.*union) [NC]
    RewriteRule .* - [F,L]
</IfModule>

# 10. FILE ACCESS RESTRICTIONS
<Files "bootstrap*">
    # Restrict direct access to bootstrap files if self-hosted
    <IfModule mod_headers.c>
        Header set X-Content-Type-Options "nosniff"
        Header set X-Frame-Options "DENY"
    </IfModule>
</Files>

# 11. PREVENT HOTLINKING OF BOOTSTRAP FILES
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?yourdomain\.com [NC]
    RewriteRule \.(css|js|woff|woff2|ttf)$ - [F,NC]
</IfModule>
