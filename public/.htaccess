<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header 
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Laravel Root .htaccess — Secure + Hostinger Compatible (Safe for Login)
# ===============================================================

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 🚫 Block direct /public access
  RewriteCond %{THE_REQUEST} "\s/public([/?#\s]|$)" [NC]
  RewriteRule ^ - [R=403,L]

  # 🚫 Block direct /index.php access
  RewriteCond %{THE_REQUEST} "^[A-Z]{3,}\s/+index\.php[?\s]" [NC]
  RewriteRule ^index\.php$ - [R=403,L]

  # ✅ Redirect everything else INTO /public (but not twice)
  RewriteCond %{REQUEST_URI} !^/public/
  RewriteRule ^(.*)$ public/$1 [L]

  # 🧱 Strict block for sensitive images (Hostinger-safe)
  # Allows internal loading, blocks manual direct browser access
  RewriteCond %{THE_REQUEST} "GET\s+/+(logo\.png|header\.png|watermark\.png)[\s?]" [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?mccgradeinfo\.com [NC]
  RewriteRule ^(logo\.png|header\.png|watermark\.png)$ - [R=403,L]
</IfModule>

# ===============================================================
# 🔒 Security Hardening
# ===============================================================
RedirectMatch 404 /\.(env|git|ht|DS_Store)
RedirectMatch 404 /\.env\..*
RedirectMatch 404 ^/(storage|vendor|bootstrap|resources|config)/.*

Options -Indexes

# ===============================================================
# 🛡️ Security Headers
# ===============================================================
<IfModule mod_headers.c>
  Header always set X-XSS-Protection "1; mode=block"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), fullscreen=(self)"
</IfModule>



<IfModule mod_rewrite.c>
    RewriteEngine On

    # ✅ ALLOW admin-login route
    RewriteCond %{REQUEST_URI} ^/admin-login$
    RewriteRule ^ - [L,NC]

    # ❌ BLOCK direct access to sensitive folders
    RewriteCond %{REQUEST_URI} ^/(resources|routes|storage|vendor|config|database|bootstrap) [NC]
    RewriteRule ^ - [F,L]

    # ❌ BLOCK direct access to .env and system files
    <FilesMatch "(\.env|composer\.(json|lock)|artisan|\.git|\.env\.example)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # ❌ BLOCK direct access to .php and .blade.php files
    <FilesMatch "\.(php|blade\.php)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    ErrorDocument 403 "403 Forbidden - Access denied."
</IfModule>
